# Example environment variables for local development and for reference.
# Copy this to `server/.env` and fill values locally (do NOT commit real secrets).

# MongoDB Atlas connection string (use a read-only or app user)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.tgtsdye.mongodb.net/lulu-mart-bangalore?retryWrites=true&w=majority"

# Port the server listens on (hosts will usually override this)
PORT=5000

# In development, set to your client dev URL (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# Razorpay keys (test/live). KEEP THESE ONLY ON THE BACKEND HOST.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_or_live_key_secret_here
